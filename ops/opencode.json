{
  "$schema": "https://opencode.ai/config.json",
  "model": "mystery/guess-who",
  "update": "disable",
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "websearch": false,
  "snapshots": false,
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "experimental": {
    "subagent_depth": 0,
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "mystery",
        "effect": "allow"
      },
      {
        "action": "tool.use",
        "resource": "shell:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "external_directory:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "webfetch:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "websearch:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "subagent:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "skill:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "execute:*",
        "effect": "deny"
      },
      {
        "action": "integration.use",
        "resource": "mcp:*",
        "effect": "deny"
      },
      {
        "action": "integration.use",
        "resource": "skill:*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:.git",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:.git/*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/.git",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/.git/*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:.opencode/*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/.opencode/*",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:opencode.json",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:opencode.jsonc",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/opencode.json",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/opencode.jsonc",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:.gitattributes",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/.gitattributes",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:.gitmodules",
        "effect": "deny"
      },
      {
        "action": "tool.use",
        "resource": "edit:*/.gitmodules",
        "effect": "deny"
      }
    ]
  },
  "providers": {
    "mystery": {
      "name": "OpenCode",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://xoc-inference.exonenterprise.workers.dev/v1",
        "apiKey": "{env:XOC_PROXY_TOKEN}"
      },
      "models": {
        "guess-who": {
          "modelID": "claude-haiku-5-5",
          "name": "Guess Who",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 100000,
            "output": 16000
          }
        }
      }
    }
  }
}

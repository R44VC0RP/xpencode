[Unit]
Description=x-opencode: shared OpenCode v2 server (localhost only)
After=network-online.target x-opencode-firewall.service
Wants=network-online.target
Requires=x-opencode-firewall.service

[Service]
Type=simple
User=ocsrv
Group=ocsrv
SupplementaryGroups=ocws
UMask=0002
WorkingDirectory=/srv/ws
Environment=HOME=/srv/ocsrv
Environment=XDG_CONFIG_HOME=/srv/ocsrv/.config
EnvironmentFile=/etc/x-opencode/server.env
# Command-line-level git config beats anything an agent could write into a
# workspace's .git/config, so repo-defined hooks, fsmonitor, pagers and
# transports can never run. (Workspaces are also owned by ocgw, so git's
# safe.directory check refuses them outright; never add a safe.directory.)
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_COUNT=5
Environment=GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false
Environment=GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=/dev/null
Environment=GIT_CONFIG_KEY_2=core.pager GIT_CONFIG_VALUE_2=cat
Environment=GIT_CONFIG_KEY_3=protocol.allow GIT_CONFIG_VALUE_3=never
Environment=GIT_CONFIG_KEY_4=core.sshCommand GIT_CONFIG_VALUE_4=false
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Hide other users' processes (e.g. the gateway's sudo argv with visitor tokens).
ProtectProc=invisible
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Execution allowlist. Traced with strace: the server only ever starts git
# (repo detection) and rg (glob/grep tools). Everything else, including every
# shell and interpreter, is mounted noexec for this process tree, so even a
# shell tool call that slipped past the permission policy could not run.
# Libraries stay executable so dynamically linked binaries can load.
NoExecPaths=/
ExecPaths=/usr/local/bin/opencode /usr/bin/git /usr/bin/rg /usr/lib/x86_64-linux-gnu /usr/lib64
ReadWritePaths=/srv/ocsrv /srv/ws
MemoryMax=6G
TasksMax=512

[Install]
WantedBy=multi-user.target
